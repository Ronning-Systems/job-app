# Joblign Local Development Environment Variables
# Copy this file to .env and fill in the values

# Database (use SQLite for local dev by leaving DATABASE_URL empty)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/joblign

# LLM Configuration
MODEL_ENDPOINT=http://localhost:11434
MODEL_PARSING=llama3.2:latest
MODEL_AGENTS=llama3.2:latest
MODEL_GENERATION=llama3.2:latest
# OLLAMA_API_KEY=  (not needed for local Ollama)

# Auth0 Configuration
# AUTH0_AUDIENCE is an opaque API identifier registered in the Auth0
# dashboard, not a user-visible brand string. Default kept as
# https://jobsync/api so existing tokens keep validating; changing it
# requires reconfiguring the Auth0 dashboard API identifier.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://jobsync/api
CORS_ORIGIN=http://localhost:8000

# Headless-browser sidecar (Playwright+chromium) for blocked job boards
# (LinkedIn, Indeed). Owned by my-stack; internal-only, not in Traefik.
# FETCHER_URL=http://fetcher:8080

# Billing (Stripe) — optional in local dev. If STRIPE_SECRET_KEY is unset,
# billing routes return 503 and all users are treated as effectively pro
# (no cap enforced). Set these to test the full paywall flow locally.
# Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO=price_...           # monthly recurring price id
# PUBLIC_SITE_URL=http://localhost:8765   # used to build checkout success/cancel URLs

# Optional: override the per-plan monthly generation caps
# BILLING_FREE_CAP=3
# BILLING_PRO_CAP=50
# BILLING_PRO_PRICE_LABEL=$9.99 / month
